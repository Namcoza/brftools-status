# Variable names only. Never put real values in this file.
# For local development, copy to .env (gitignored) and fill in there.
# In production, .env is rendered from 1Password by the deploy script.
# Every variable here is also described in README.md.

PORT=
APP_VERSION=
# Format: postgres://USER@HOST:5432/DATABASE, with the password supplied by the environment
DATABASE_URL=

# Minecraft servers shown on the home page: MC_1_* to MC_4_*. Omit all to hide the section.
# PING is host:port as reachable from the container; NAME is required with it.
MC_1_NAME=
MC_1_PING=
MC_1_JOIN=
MC_1_MAP_URL=

# Tailscale summary file written by the host timer, as seen inside the container. Unset hides the section.
TAILSCALE_STATUS_FILE=
