# Variable names only. Never put real values in this file.
# For local development, copy to .env (gitignored) and fill in there.
# In production, .env is rendered from 1Password by the deploy script.
# Every variable here is also described in README.md.

PORT=
APP_VERSION=
# Format: postgres://USER@HOST:5432/DATABASE, with the password supplied by the environment
DATABASE_URL=

# Minecraft servers shown on the home page: MC_1_* to MC_4_*. Omit all to hide the section.
# PING is host:port as reachable from the container; NAME is required with it.
MC_1_ID=
MC_1_NAME=
MC_1_PING=
MC_1_JOIN=
MC_1_MAP_URL=

# Tailscale summary file written by the host timer, as seen inside the container. Unset hides the section.
TAILSCALE_STATUS_FILE=

# Private Minecraft admin menu (README, "Admin menu"). Set all five, or none to switch it off.
# Needs MC_n_ID for every server. ACCESS_AUD is the Access application's audience tag.
ADMIN_HOSTNAME=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
MC_ACTIONS_INBOX_DIR=
MC_ACTIONS_STATE_DIR=
# The owner's Google account email: the only account the admin menu accepts, and always allowed on the status page.
OWNER_EMAIL=

# Media services shown on the home page: MEDIA_1_* to MEDIA_12_*. Omit all to hide the section.
# CHECK is the credential-free health URL; URL is where the admin menu's /open/<id> sends you.
# Addresses appear only here and behind Access — never on the public page.
MEDIA_1_ID=
MEDIA_1_NAME=
MEDIA_1_KIND=
MEDIA_1_CHECK=
MEDIA_1_URL=
MEDIA_1_LAN_URL=

# Header and footer links, so each surface knows about the others. All optional.
PUBLIC_STATUS_URL=
PUBLIC_GAMES_URL=
PUBLIC_MAP_URL=

# Decorative, non-monitored facts for the Overview and Remote access tabs: drive usage,
# hardware labels, open issues and the "who can reach what" table. One JSON object; see
# README.md, "Overview and Remote access facts" for the shape. Unset hides all of it.
# Never put real values (IP addresses, paths) in this file — see AGENTS.md.
HOME_FACTS_JSON=
